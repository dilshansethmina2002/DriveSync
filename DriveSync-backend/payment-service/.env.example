# ------------------------------------------------------------
# DriveSync Payment Service - environment variables
# Copy this file to ".env" and change the values.
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Mac / Linux / Git Bash: cp .env.example .env
# ------------------------------------------------------------

# Port this service listens on (fixed by the team architecture)
PORT=5004

# development | production
NODE_ENV=development

# This service's OWN database. Never point this at another service's DB.
MONGO_URI=mongodb://127.0.0.1:27017/drivesync_payment_db

# MUST be exactly the same secret the Auth Service (Member 1) uses to sign tokens.
# Note: if the Auth Service has no .env, it signs with 'fallback_secret'.
JWT_SECRET=change_me_to_the_same_secret_as_auth_service

# Shared secret that other microservices send in the "x-service-key" header
# for internal service-to-service calls (no user token needed).
SERVICE_API_KEY=change_me_internal_service_key

# Comma separated list of frontends / gateways allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:5000

# Currency used when the request does not send one
DEFAULT_CURRENCY=LKR

# ---- Booking Service integration (Member 2) ----
BOOKING_SERVICE_URL=http://localhost:5003
# true  = check the booking exists, belongs to the customer and the amount matches
# false = trust the values sent in the request (handy while Booking Service is not running)
VERIFY_BOOKING=false
# true = after a successful rental payment, ask Booking Service to set status "Confirmed"
NOTIFY_BOOKING_ON_PAYMENT=false

# Simulated gateway delay in milliseconds (pretends to "talk to the bank")
GATEWAY_DELAY_MS=300

# Optional: DNS servers Node uses to look up Atlas "mongodb+srv://" addresses.
# Set this if you get "querySrv ECONNREFUSED" when connecting to Atlas.
DNS_SERVERS=8.8.8.8,1.1.1.1
