# ------------------------------------------------------------
# DriveSync Fleet Management Service - environment variables
# Copy this file to ".env" and change the values.
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Mac / Linux / Git Bash: cp .env.example .env
# ------------------------------------------------------------

PORT=5005
NODE_ENV=development

# This service's OWN database
MONGO_URI=mongodb://127.0.0.1:27017/drivesync_fleet_db

# MUST be exactly the same secret the Auth Service (Member 1) uses
JWT_SECRET=change_me_to_the_same_secret_as_auth_service

# Shared key for internal calls from other services (e.g. Booking Service)
SERVICE_API_KEY=change_me_internal_service_key

CORS_ORIGINS=http://localhost:5173,http://localhost:5000

# When maintenance is completed and no next date is given,
# schedule the next service this many days later
MAINTENANCE_INTERVAL_DAYS=90

# Optional: DNS servers Node uses to look up Atlas "mongodb+srv://" addresses.
# Set this if you get "querySrv ECONNREFUSED" when connecting to Atlas.
DNS_SERVERS=8.8.8.8,1.1.1.1
