{
  "name": "drivesync-backend",
  "version": "1.0.0",
  "description": "DriveSync Microservices Backend",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "concurrently -n \"gateway,auth,catalog,booking,payment,fleet\" -c \"magenta,blue,cyan,yellow,green,red\" \"npm --prefix api-gateway start\" \"npm --prefix auth-service start\" \"npm --prefix catalog-service start\" \"npm --prefix booking-services start\" \"npm --prefix payment-service run dev\" \"npm --prefix fleet-service run dev\"",
    "dev": "npm start",
    "gateway": "npm --prefix api-gateway start",
    "auth": "npm --prefix auth-service start",
    "catalog": "npm --prefix catalog-service start",
    "booking": "npm --prefix booking-services start",
    "payment": "npm --prefix payment-service dev",
    "fleet": "npm --prefix fleet-service dev"
  },
  "keywords": [
    "drivesync",
    "microservices",
    "vehicle-rental",
    "fleet"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "concurrently": "^9.1.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "mongoose": "^9.12.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
