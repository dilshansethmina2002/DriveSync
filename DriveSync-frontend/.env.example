# ------------------------------------------------------------
# DriveSync frontend settings (Vite only exposes variables that start with VITE_)
# Copy to ".env" and restart "npm run dev" after changing.
# ------------------------------------------------------------

# Every API call goes through the API Gateway (Member 1) - never directly to 5004/5005
VITE_API_BASE_URL=http://localhost:5000

# true  = use built-in SAMPLE data (no backend needed). A yellow "MOCK MODE" banner is shown.
# false = use the real backend through the API Gateway
VITE_USE_MOCK=false

# Security deposit charged at checkout, and the display currency
VITE_SECURITY_DEPOSIT=5000
VITE_CURRENCY=LKR
